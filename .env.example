# Binance API Keys
# Get your keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Testnet (set to "true" for paper trading, "false" for live trading)
USE_TESTNET=true

# Trading Configuration
SYMBOL=BTC/USDT
TIMEFRAME=1h
TRADE_AMOUNT_USDT=100

# EMA Settings
EMA_SHORT=9
EMA_LONG=21

# Risk Management
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
