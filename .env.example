# Exchange selection: "binance", "gateio", or "upbit"
EXCHANGE=upbit

# Binance API Keys
# Get your keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Gate.io API Keys (used when EXCHANGE=gateio)
# Get your keys from: https://www.gate.io/myaccount/apikeys
# NOTE: Gate.io does not support testnet — use a sub-account with small funds for testing
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_SECRET_KEY=your_gateio_secret_key_here

# Upbit API Keys (used when EXCHANGE=upbit)
# Get your keys from: https://upbit.com/mypage/open_api_management
# NOTE: Upbit does not support testnet — always trades on live account
UPBIT_API_KEY=NnA1SVHGThpEiVkEadXFli3rZp1h9olO6D9DCi9J
UPBIT_SECRET_KEY=R3BQLihx6YxO5PqsRrtZ7sQ33qOLIdysn6oUdQwJ

# Testnet (only applies to Binance; Gate.io and Upbit ignore this)
USE_TESTNET=true

# Trading Configuration
# Upbit: use KRW amount (e.g. 100000 = 10만원)
# Binance/Gate.io: use USDT amount (e.g. 100 = $100)
SYMBOL=BTC/KRW
TIMEFRAME=1h
TRADE_AMOUNT=100000

# Telegram Notifications (optional — leave blank to disable)
# 1. Create a bot via @BotFather and get the token
# 2. Send a message to your bot, then get your chat_id via:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# EMA Settings
EMA_SHORT=9
EMA_LONG=21

# Stage-1 Filters (ADX + RSI + Volume)
# ADX: skip trading if market is ranging (ADX below threshold)
ADX_PERIOD=14
ADX_THRESHOLD=20

# RSI: only buy when momentum is confirming but not yet overbought
RSI_PERIOD=14
RSI_MIN=45
RSI_MAX=65

# Volume: only trade when volume is at least this multiple of its 20-bar average
VOLUME_MA_PERIOD=20
VOLUME_SPIKE_MULT=1.3

# Risk Management
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
